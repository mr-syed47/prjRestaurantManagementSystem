@using prjRestaurantManagementSystem.Models

@{
    Layout = null;

    Customer customer = Model;
    bool isEdit = customer.CustomerId > 0;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(isEdit ? "Update Customer" : "Add Customer")
    </title>

    <link rel="stylesheet" href="~/css/style.css" />

    <style>
        .form-card {
            background-color: white;
            max-width: 700px;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

        .form-card h2 {
            margin-bottom: 25px;
            color: #343434;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #444;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }

        .form-group input:focus {
            border-color: #df3038;
        }

        .form-actions {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        .save-button {
            background-color: #df3038;
            color: white;
            border: none;
            padding: 12px 22px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .save-button:hover {
            background-color: #b9252c;
        }

        .back-button {
            background-color: #777;
            color: white;
            text-decoration: none;
            padding: 12px 22px;
            border-radius: 6px;
        }

        .back-button:hover {
            color: white;
            background-color: #555;
        }
    </style>

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo">
            RMS
        </div>

        <div class="menu-title">
            Main Menu
        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">⌂</span>
            Dashboard

        </a>


        <a asp-controller="Customer"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">👤</span>
            Customers

        </a>


        <a asp-controller="Order"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">🛒</span>
            Orders

        </a>


        <a asp-controller="OrderDetail"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">📋</span>
            Order Details

        </a>

    </div>


    <!-- Main Area -->

    <div class="main">

        <!-- Topbar -->

        <div class="topbar">

            <div class="menu-button">
                ☰
            </div>

            <div class="admin">
                Admin
            </div>

        </div>


        <!-- Form Content -->

        <div class="content">

            <div class="page-header">

                <div>

                    <h1>
                        @(isEdit ? "Update Customer" : "Add Customer")
                    </h1>

                    <p>
                        @(isEdit
                            ? "Update customer information"
                            : "Add a new customer to the system")
                    </p>

                </div>

            </div>


            <div class="form-card">

                <h2>
                    Customer Information
                </h2>


                <form method="post"
                      asp-controller="Customer"
                      asp-action="@(isEdit ? "Update" : "Save")">

                    <input type="hidden"
                           name="CustomerId"
                           value="@customer.CustomerId" />


                    <div class="form-group">

                        <label>
                            Customer Name
                        </label>

                        <input type="text"
                               name="CustomerName"
                               value="@customer.CustomerName"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Phone
                        </label>

                        <input type="text"
                               name="Phone"
                               value="@customer.Phone" />

                    </div>


                    <div class="form-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               name="Email"
                               value="@customer.Email" />

                    </div>


                    <div class="form-group">

                        <label>
                            Address
                        </label>

                        <input type="text"
                               name="Address"
                               value="@customer.Address" />

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="save-button">

                            @(isEdit ? "Update Customer" : "Save Customer")

                        </button>


                        <a asp-controller="Customer"
                           asp-action="Index"
                           class="back-button">

                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>