@using prjRestaurantManagementSystem.Models

@{
    Layout = null;

    List<Order> orders = Model;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Orders - Restaurant Management</title>

    <link rel="stylesheet" href="~/css/style.css" />

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo">
            RMS
        </div>

        <div class="menu-title">
            Main Menu
        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">⌂</span>
            Dashboard

        </a>


        <a asp-controller="Customer"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">👤</span>
            Customers

        </a>


        <a asp-controller="Order"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">🛒</span>
            Orders

        </a>


        <a asp-controller="OrderDetail"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">📋</span>
            Order Details

        </a>

    </div>


    <!-- Main Area -->

    <div class="main">

        <!-- Topbar -->

        <div class="topbar">

            <div class="menu-button">
                ☰
            </div>

            <div class="admin">
                Admin
            </div>

        </div>


        <!-- Order Content -->

        <div class="content">

            <div class="page-header">

                <div>

                    <h1>Orders</h1>

                    <p>
                        Manage restaurant orders
                    </p>

                </div>


                <a asp-controller="Order"
                   asp-action="Edit"
                   asp-route-id="0"
                   class="add-button">

                    + Add Order

                </a>

            </div>


            <!-- Order Table -->

            <div class="table-card">

                <table>

                    <thead>

                        <tr>

                            <th>Order ID</th>

                            <th>Customer ID</th>

                            <th>Order Date</th>

                            <th>Total Amount</th>

                            <th>Status</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in orders)
                        {
                            <tr>

                                <td>
                                    @order.OrderId
                                </td>

                                <td>
                                    @order.CustomerId
                                </td>

                                <td>
                                    @order.OrderDate
                                </td>

                                <td>
                                    @order.TotalAmount
                                </td>

                                <td>
                                    @order.OrderStatus
                                </td>


                                <td>

                                    <a asp-controller="Order"
                                       asp-action="Edit"
                                       asp-route-id="@order.OrderId"
                                       class="edit-button">

                                        Edit

                                    </a>


                                    <a asp-controller="Order"
                                       asp-action="Delete"
                                       asp-route-id="@order.OrderId"
                                       class="delete-button"
                                       onclick="return confirm('Are you sure you want to delete?');">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</body>
</html>