@using prjRestaurantManagementSystem.Models

@{
    Layout = null;

    OrderDetail orderDetail = Model;
    bool isEdit = orderDetail.OrderDetailId > 0;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(isEdit ? "Update Order Detail" : "Add Order Detail")
    </title>

    <link rel="stylesheet" href="~/css/style.css" />

    <style>

            .form-card {
                background-color: white;
                max-width: 700px;
                padding: 30px;
                border-radius: 12px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            }

            .form-card h2 {
                margin-bottom: 25px;
                color: #343434;
            }

            .form-group {
                margin-bottom: 20px;
            }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
                color: #444;
            }

            .form-group input,
            .form-group select {
                width: 100%;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 6px;
                font-size: 14px;
                outline: none;
                background-color: white;
            }

            .form-group input:focus,
            .form-group select:focus {
                border-color: #df3038;
            }

            .form-actions {
                margin-top: 25px;
                display: flex;
                gap: 10px;
            }

            .save-button {
                background-color: #df3038;
                color: white;
                border: none;
                padding: 12px 22px;
                border-radius: 6px;
                cursor: pointer;
                font-weight: bold;
            }

            .save-button:hover {
                background-color: #b9252c;
            }

            .back-button {
                background-color: #777;
                color: white;
                text-decoration: none;
                padding: 12px 22px;
                border-radius: 6px;
            }

            .back-button:hover {
                color: white;
                background-color: #555;
            }

    </style>

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo">
            RMS
        </div>

        <div class="menu-title">
            Main Menu
        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">⌂</span>
            Dashboard

        </a>


        <a asp-controller="Customer"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">👤</span>
            Customers

        </a>


        <a asp-controller="Order"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">🛒</span>
            Orders

        </a>


        <a asp-controller="OrderDetail"
           asp-action="Index"
           class="menu-item">

            <span class="menu-icon">📋</span>
            Order Details

        </a>

    </div>


    <!-- Main Area -->

    <div class="main">

        <!-- Topbar -->

        <div class="topbar">

            <div class="menu-button">
                ☰
            </div>

            <div class="admin">
                Admin
            </div>

        </div>


        <!-- Order Detail Form -->

        <div class="content">

            <div class="page-header">

                <div>

                    <h1>
                        @(isEdit ? "Update Order Detail" : "Add Order Detail")
                    </h1>

                    <p>
                        @(isEdit
                            ? "Update restaurant order item information"
                            : "Add a new item to the order")
                    </p>

                </div>

            </div>


            <div class="form-card">

                <h2>
                    Order Detail Information
                </h2>


                <form method="post"
                      asp-controller="OrderDetail"
                      asp-action="@(isEdit ? "Update" : "Save")">


                    <!-- Hidden ID -->

                    <input type="hidden"
                           name="OrderDetailId"
                           value="@orderDetail.OrderDetailId" />


                    <!-- Order -->

                    <div class="form-group">

                        <label>
                            Order
                        </label>

                        <select name="OrderId"
                                required>

                            <option value="">
                                -- Select Order --
                            </option>

                            @foreach (var order in ViewBag.Orders)
                            {
                                if (order.OrderId == orderDetail.OrderId)
                                {
                                    <option value="@order.OrderId" selected>
                                        Order #@order.OrderId
                                    </option>
                                }
                                else
                                {
                                    <option value="@order.OrderId">
                                        Order #@order.OrderId
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Item Name -->

                    <div class="form-group">

                        <label>
                            Item Name
                        </label>

                        <input type="text"
                               name="ItemName"
                               value="@orderDetail.ItemName"
                               required />

                    </div>


                    <!-- Quantity -->

                    <div class="form-group">

                        <label>
                            Quantity
                        </label>

                        <input type="number"
                               name="Quantity"
                               value="@orderDetail.Quantity"
                               min="1"
                               required />

                    </div>


                    <!-- Unit Price -->

                    <div class="form-group">

                        <label>
                            Unit Price
                        </label>

                        <input type="number"
                               name="UnitPrice"
                               value="@orderDetail.UnitPrice"
                               step="0.01"
                               min="0"
                               required />

                    </div>


                    <!-- Total Price -->

                    <div class="form-group">

                        <label>
                            Total Price
                        </label>

                        <input type="number"
                               name="TotalPrice"
                               value="@orderDetail.TotalPrice"
                               step="0.01"
                               min="0"
                               required />

                    </div>


                    <!-- Buttons -->

                    <div class="form-actions">

                        <button type="submit"
                                class="save-button">

                            @(isEdit ? "Update Order Detail" : "Save Order Detail")

                        </button>


                        <a asp-controller="OrderDetail"
                           asp-action="Index"
                           class="back-button">

                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>